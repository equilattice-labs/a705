# Solana environment (copy to `.env.local` for local overrides)
# Supported values: devnet, testnet, mainnet-beta, localnet.
VITE_SOLANA_CLUSTER=testnet
# Leave blank to use the cluster's public RPC. Use a provider URL in production.
VITE_SOLANA_RPC_URL=
# Public SPL mint addresses are selected by VITE_SOLANA_CLUSTER.
# Leave these blank until an official Orbinza CA is published and verified.
VITE_SOLANA_DEVNET_TOKEN_MINT=
VITE_SOLANA_TESTNET_TOKEN_MINT=
